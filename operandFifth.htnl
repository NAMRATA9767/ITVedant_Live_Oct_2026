<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Website</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <a href="#" class="logo"><strong>MyBrand</strong></a>
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#features">Features</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <header id="home" class="container text-center mt-2 mb-2">
    <h1>Welcome to My Website</h1>
    <p class="text-muted">A simple, clean starter page built with HTML and CSS.</p>
    <a href="#features" class="btn">Get Started</a>
    <a href="#contact" class="btn btn-outline">Contact Me</a>
  </header>

  <!-- Features Section -->
  <section id="features" class="container mb-2">
    <h2 class="text-center mb-2">Features</h2>
    <div class="grid">
      <div class="card">
        <h3>Responsive</h3>
        <p>Looks great on phones, tablets, and desktops.</p>
      </div>
      <div class="card">
        <h3>Dark Mode</h3>
        <p>Automatically adapts to the user's system theme.</p>
      </div>
      <div class="card">
        <h3>Clean Design</h3>
        <p>Minimal styling that's easy to customize.</p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="container mb-2">
    <h2 class="text-center mb-1">Contact</h2>
    <form class="card" style="max-width: 500px; margin: 0 auto;">
      <div class="mb-1">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required>
      </div>
      <div class="mb-1">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="you@example.com" required>
      </div>
      <div class="mb-1">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4" placeholder="Write your message..."></textarea>
      </div>
      <button type="submit" class="btn">Send Message</button>
    </form>
  </section>

  <!-- Footer -->
  <footer class="text-center text-muted mt-2 mb-2">
    <p>&copy; 2026 MyBrand. All rights reserved.</p>
  </footer>

</body>
</html>